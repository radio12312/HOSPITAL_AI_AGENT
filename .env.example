# Copy to .env and fill in. Never commit .env.

# Free key from https://build.nvidia.com (open any model -> "Get API Key")
NVIDIA_API_KEY=nvapi-your-key-here

# Secret used to sign login tokens. Use a long random string outside local demos.
JWT_SECRET=change-me-in-production

# Database (Docker Compose sets this automatically; this value is for running the backend locally)
DATABASE_URL=postgresql+psycopg://hospital:hospital@localhost:5432/hospital

# LLM models (NVIDIA API catalog). The primary is probed at startup; the fallback is used if it fails.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_DISABLE_THINKING=true
LLM_CACHE_ENABLED=true

# Agent workflow
# Reviewer: fixed | naive (naive reproduces the failure mode in docs/FAILURE_MODE.md)
REVIEWER_MODE=fixed
# Reviewer rejections allowed before the run goes to human review
MAX_REVISIONS=2
